# =============================================================================
# EduShift - desarrollo local (cp .env.dev.example .env)
# Defaults seguros para desarrollo. NO commitear .env.
# =============================================================================

SPRING_PROFILES_ACTIVE=dev
APP_VERSION=dev
BACKEND_HOST_PORT=8080
SERVER_CONTEXT_PATH=/api

# Frontend / CORS
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
CORS_ALLOW_CREDENTIALS=true

# PostgreSQL (contenedor docker-compose)
DB_NAME=edushift
DB_USER=edushift
DB_PASSWORD=edushift
DB_SCHEMA=edushift
DB_SSL_MODE=disable
DB_PORT=5433
DB_HOST_PORT=5433

# Hikari (dev: pool pequeño)
HIKARI_MINIMUM_IDLE=2
HIKARI_MAXIMUM_POOL_SIZE=5

# Flyway
FLYWAY_ENABLED=true
FLYWAY_SCHEMAS=edushift
FLYWAY_DEFAULT_SCHEMA=edushift

# Redis (dev: sin password en el contenedor de override)
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_KEY_PREFIX=edushift:
REDIS_MAXMEMORY=128mb
REDIS_HOST_PORT=6380

# JWT (dev) - secreto generado solo para desarrollo. Generar uno nuevo con:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-with-openssl-rand-base64-48-chars-min
JWT_ISSUER=edushift-dev
JWT_AUDIENCE=edushift-clients-dev
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d

# MiniMax (AI habilitada por default en todos los profiles)
# Si MINIMAX_ENABLED=true y MINIMAX_API_KEY está vacía, LlmAutoConfiguration
# degrada a MockLlmClient automáticamente (sin tirar excepción). Para forzar
# mock explícitamente: MINIMAX_ENABLED=false
# Generar key nueva: https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_ENABLED=true
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_DEFAULT_MODEL=MiniMax-M3
MINIMAX_TIMEOUT=30s
MINIMAX_MAX_RETRIES=2

# Firebase (desactivado por defecto en dev)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# -----------------------------------------------------------------------------
# Files / Storage provider (docs/infra/firebase.md)
# En dev usamos LOCAL_FS: blobs viven en ./edushift-storage y se sirven
# por el propio BE (GET /api/v1/files/{uuid}/download con bearer).
# Para probar Firebase en dev: STORAGE_PROVIDER=FIREBASE + credenciales.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=LOCAL_FS
STORAGE_MAX_FILE_SIZE_BYTES=26214400
STORAGE_LOCAL_FS_ROOT=./edushift-storage
STORAGE_LOCAL_FS_SERVE_FROM_CONTROLLER=true
STORAGE_FIREBASE_BUCKET=edushift-storage
STORAGE_FIREBASE_CREDENTIALS_JSON={
  "type": "service_account",
  "project_id": "REPLACE_ME",
  "private_key_id": "REPLACE_ME",
  "private_key": "-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n",
  "client_email": "REPLACE_ME.iam.gserviceaccount.com",
  "client_id": "REPLACE_ME",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/REPLACE_ME",
  "universe_domain": "googleapis.com"
}
STORAGE_FIREBASE_CREDENTIALS_PATH=
STORAGE_FIREBASE_SIGNED_URL_TTL=900

# -----------------------------------------------------------------------------
# SMTP / emails transaccionales (invitaciones, password reset, eventos 1:1)
# Requiere AMBAS flags: enabled=true + SPRING_MAIL_HOST con credenciales.
# Anuncios NO envían email (solo in-app) para no saturar Gmail.
# Ver docs/qa/08-smtp-checklist.md
# -----------------------------------------------------------------------------
APP_NOTIFICATIONS_EMAIL_ENABLED=false
APP_NOTIFICATIONS_EMAIL_FROM=noreply@edushift.local
# Logo público HTTPS de fallback cuando el tenant no tiene branding.logoUrl
APP_NOTIFICATIONS_EMAIL_DEFAULT_LOGO_URL=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# JVM
JAVA_OPTS=-Xms256m -Xmx512m
DEBUG_PORT=5005

# -----------------------------------------------------------------------------
# Logging (dev: consola legible con colores)
# -----------------------------------------------------------------------------
LOG_PATH=./logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
APP_LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=DEBUG
SQL_LOGGING_ENABLED=true
SQL_LOGGING_LEVEL=DEBUG
SQL_BIND_LOGGING_LEVEL=TRACE
HIKARI_LOG_LEVEL=INFO
FLYWAY_LOG_LEVEL=DEBUG
REDIS_LOG_LEVEL=INFO
